# Static build output. Produced by tools/build-static.php in CI and published
# from there; it is never committed, because a stale dist/ in the repo is worse
# than no dist/ at all.
/dist/
/dist-root/

# Written by includes/enquiry-handler.php on every submission, whether or not
# mail() is configured. It holds what patients typed about their own medicines,
# so it must never reach the repository. .htaccess already refuses /data/ over
# HTTP; this is the other half of that.
/data/enquiries.log

# API keys (the newsdata.io key for /articles). data/secrets.example.php is the
# committed template; the real file stays on the machine it was written on.
/data/secrets.php

# Headlines fetched for /articles. Rebuilt on demand, so never worth committing.
/data/cache/

# OS and editor noise.
Thumbs.db
.DS_Store
*.swp

# Prescriptions uploaded through /order. Health information about real
# patients: it must never reach the repository. .htaccess refuses /data/ over
# HTTP, and data/uploads/.htaccess refuses it again; this is the third lock.
/data/uploads/
/data/orders.log
