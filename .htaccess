# Getmeds Vanuatu — Apache configuration.
#
# Everything here is defensive or a performance measure. The site works without
# this file; it is just slower and less tidy. Drop the folder into htdocs and it
# runs with no other configuration.

# ---------------------------------------------------------------------------
# Directory index
# ---------------------------------------------------------------------------
DirectoryIndex index.php index.html

# Never list a directory's contents.
Options -Indexes

# ---------------------------------------------------------------------------
# Protect files that must never be served
# ---------------------------------------------------------------------------
<FilesMatch "\.(log|md)$">
  Require all denied
</FilesMatch>

# Build files that say which tools and versions the site is built with.
<FilesMatch "^(package(-lock)?\.json|composer\.(json|lock))$">
  Require all denied
</FilesMatch>

# config.php returns an array and prints nothing, but it is the site's whole
# settings file: no reason for it to answer over HTTP at all.
<FilesMatch "^config\.php$">
  Require all denied
</FilesMatch>

# Backups, editor leftovers, dumps and archives. An "index.php.bak" or a
# "site.zip" left behind after an edit would be served as plain text or a
# download, source code and all.
<FilesMatch "(\.(bak|old|orig|save|swp|swo|tmp|sql|sqlite|db|ini|env|log|zip|tar|gz|tgz|7z|rar)|~)$">
  Require all denied
</FilesMatch>

# Do not print the Apache version on error pages.
ServerSignature Off

# The enquiry log lives under data/ and contains people's contact details.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^data/ - [F,L]
  RewriteRule ^includes/ - [F,L]
  RewriteRule ^docs/ - [F,L]
  # Build scripts, and every hidden file or folder (.git holds the whole
  # source history; .github, .claude and the rest are tooling). Only
  # .well-known stays open, for the SSL certificate check.
  RewriteRule ^tools/ - [F,L]
  RewriteRule (^|/)\.(?!well-known/) - [F,L]

  # Live site: always HTTPS. Prescriptions and patient IDs are uploaded through
  # these forms, so they must never travel in the clear. Skipped on this
  # computer (localhost) so XAMPP keeps working over plain http. A proxy or CDN
  # that ends HTTPS in front of the site says so in X-Forwarded-Proto, which is
  # checked so the redirect cannot loop.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https [NC]
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\])(:\d+)?$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Sitemaps and robots.txt are generated from the pages that exist, so they
  # never go stale. tools/build-static.php writes the same three as real files.
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^sitemap-(pages|categories|products)\.xml$ sitemap.php?set=$1 [L]
  RewriteRule ^sitemap-images\.xml$ sitemap-images.php [L]
  RewriteRule ^robots\.txt$ robots.php [L]

  # The Product Range: /product-range/... is one PHP page, which works out
  # which it is. The old /medicines/shop/... addresses redirect to it.
  RewriteRule ^product-range/.+ product-range/index.php [L]
  RewriteRule ^medicines/shop/.+ medicines/shop/index.php [L]

  # Strip a trailing index.php so the canonical URL is the directory.
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.php[\s?] [NC]
  RewriteRule ^(.*/)?index\.php$ /%1 [R=301,L]

  # An address that matches no file or folder goes to the Product Range
  # router: it is a category (/<category>/) or product (/<category>/<product>/)
  # page, or else the router shows the site's own 404 page with a 404 status.
  # A relative target, so it works wherever the site is mounted (ErrorDocument
  # below needs a path from the web root, which only works at the root).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ product-range/index.php [L]
</IfModule>

# ---------------------------------------------------------------------------
# Security headers
#
# The CSP is strict because this site loads almost nothing from anywhere else:
# no CDN, no analytics, no fonts from Google. If you ever add a third party,
# this is the line that has to change, and changing it should be a deliberate
# decision rather than an accident.
#
# The one deliberate exception is img-src https: — the news cards on /articles
# show each outlet's own photograph, from that outlet's server, and the outlets
# are not known in advance. Images only: scripts, styles, fonts and forms are
# still this site's alone. Remove "https:" and the news cards fall back to the
# stand-in picture (assets/img/articlenoimagefallback).
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; form-action 'self'; frame-ancestors 'self'; frame-src https://www.google.com https://maps.google.com; base-uri 'self'; object-src 'none'"

  # Do not leak the PHP version.
  Header unset X-Powered-By

  # HSTS: once a browser has seen the site over HTTPS, it refuses plain http
  # for a year. Sent only on HTTPS responses, so localhost is unaffected.
  # A year, without includeSubDomains or preload: those are hard to undo, and
  # whether every subdomain is on HTTPS is a decision for whoever runs the domain.
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on' || %{HTTP:X-Forwarded-Proto} == 'https'"

  # Answers that carry what someone typed or uploaded must not sit in a
  # shared or browser cache.
  Header always set Cache-Control "no-store" "expr=%{REQUEST_METHOD} == 'POST'"
</IfModule>

# ---------------------------------------------------------------------------
# Compression. Connections in Vanuatu are slow and metered; this matters more
# here than it does in most places.
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  # Photographs and fonts arrive compressed already. Running deflate over them
  # burns CPU and can make the response marginally larger.
  SetEnvIfNoCase Request_URI \.(?:webp|jpe?g|png|woff2)$ no-gzip dont-vary
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/javascript image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# Caching. The font files are content-addressed by name and never change, so
# they can be cached for a year. HTML must not be cached, because the
# compliance values in the footer have to be updatable in one edit.
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2            "access plus 1 year"
  ExpiresByType image/svg+xml         "access plus 1 month"
  # Photographic plates. The filename carries its width, not a content hash, so
  # a replaced photograph would keep its name: a month, not a year, and not
  # immutable. Long enough that a patient on a slow island connection never
  # re-downloads them, short enough that a correction lands.
  ExpiresByType image/webp            "access plus 1 month"
  ExpiresByType image/jpeg            "access plus 1 month"
  ExpiresByType text/css              "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresDefault                      "access plus 1 hour"
  ExpiresByType text/html             "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# Correct types, in case the server is missing them
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  AddCharset UTF-8 .css .js .html
</IfModule>

# ---------------------------------------------------------------------------
# Error documents. Keep people on the site rather than on an Apache page.
# ---------------------------------------------------------------------------
ErrorDocument 404 /404.php
ErrorDocument 403 /404.php
